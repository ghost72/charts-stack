# Central configuration with secrets - NEVER commit. Only .env.example (template)
# is versioned.
.env
.env.*
!.env.example
# Personal env copies/merges with real secrets (e.g. env_nas, env_new, env.bak).
# Never commit these - they hold tokens/passwords. Only .env.example is public.
env_*
*.env

# Local playlist definition file (optional, CHARTS_FILE). The template
# charts.json.example stays versioned; charts.json itself is personal config
# and is not tracked, so your own/private lists are never committed:
charts-sync/charts.json

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Local workspace files and OS clutter
.DS_Store

# Internal planning notes (not for public release)
docs/
