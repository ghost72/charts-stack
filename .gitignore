# Central configuration with secrets - NEVER commit. Only .env.example (template)
# is versioned.
.env
.env.*
!.env.example
# Only the empty directory marker is tracked; generated backups contain secrets.
!.env-backups/
.env-backups/*
!.env-backups/.gitkeep
# Personal env copies/merges with real secrets (e.g. env_nas, env_new, env.bak).
# Never commit these - they hold tokens/passwords. Only .env.example is public.
env_*
!charts-config/app/env_editor.py
*.env

# Local playlist definition file (optional, CHARTS_FILE). The template
# charts.json.example stays versioned; charts.json itself is personal config
# and is not tracked, so your own/private lists are never committed:
charts-sync/charts.json
# Local Energy channel definition file (optional, ENERGY_CHANNELS_FILE). Same
# deal: energy-channels.json.example stays versioned, the real
# energy-channels.json is personal config and is not tracked:
charts-energy/energy-channels.json

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Local workspace files and OS clutter
.DS_Store
# Local git worktrees (e.g. .worktrees/github-ready); never committed.
.worktrees/

# Runtime sessions stay local, including in the private NAS repository.
.copilot/
.claude/

# Local workspace context excluded from application releases.
.agents/
.kiro/
.copilot/
.claude/
.worktrees/
**/.github/agents/
**/.github/instructions/
**/.github/prompts/
**/.github/chatmodes/
**/.github/skills/
**/.github/modernize/
AGENTS.md
CLAUDE.md
AI-HANDOVER.md
copilot-instructions.md
/docs/AI-HANDOVER.md
/docs/I18N-TODO.md
/docs/ROBUSTNESS-TODO.md
/.github/copilot-instructions.md
