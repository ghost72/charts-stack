# ============================================================
#  charts-stack – central configuration (ONE file for all services)
#  Copy this file to ".env" and adjust the values:
#      cp .env.example .env
#  Then: create a Container Manager project pointing at this folder
#  OR:   docker compose up -d --build
# ============================================================

# ─── REQUIRED ───────────────────────────────────────────────
# You MUST set these values, otherwise the services will not start.

# Host folder with the subfolders Music/ (Navidrome library), Charts/
# (slskd downloads) and SeedShare/. Synology DSM default: /volume2/music
MUSIC_ROOT=/volume2/music

# slskd API key (role "readwrite" from slskd.yml). See slskd/README.md.
# Used by charts-download, charts-upgrade and charts-songrequest.
SLSKD_API_KEY=

# Login for the charts-songrequest web UI (it will not start without a user).
# Pure multi-user login: SONGREQUEST_USERS="user1:pass1,user2:pass2".
# Separate users with a comma, user and password with a colon; a password
# must not contain ':' or ',' (those are the separators):
#   SONGREQUEST_USERS=alice:secret1,bob:secret2,carol:secret3
SONGREQUEST_USERS=

# Pushover device per user (optional). Format user:device, several comma-separated.
# Matches the login username from SONGREQUEST_USERS. Whoever is listed here
# gets a Pushover availability message to EXACTLY this device when their
# manually requested song is imported. Not listed / empty -> no message
# (never to everyone). Example:
#   USER_PUSHOVER_DEVICES=max:iPhone-Max,anna:Tablet-Anna
USER_PUSHOVER_DEVICES=

# ─── OPTIONAL: charts-recommend (multi-user top-up service) ─────────────────
# charts-recommend reads the PUBLIC listening taste of several ListenBrainz
# users and lets the SHARED library grow (it no longer writes playlists -
# the personalisation is done by the client/Substreamer per account).
#
# List of public ListenBrainz USERNAMES (comma-separated). Usernames only
# - public, NOT a secret. You may also add OTHER people's public ListenBrainz
# accounts here whose taste you like. Empty = feature off (the service then
# simply runs empty, no error).
#   RECOMMEND_LISTENBRAINZ_USERS=yourusername,afriend,someoneelse
RECOMMEND_LISTENBRAINZ_USERS=
# Which data sources (comma-separated): stats (most-played songs, available
# immediately) and/or createdfor (Weekly Jams/Exploration, maybe only after 2-4 weeks).
RECOMMEND_SOURCES=stats,createdfor
# Time range for the stats source: week|month|quarter|half_yearly|year|all_time.
RECOMMEND_STATS_RANGE=month
# ListenBrainz token ONLY to raise the rate limit when reading the listed
# users (recommended when several users are queried). NO password needed -
# the public profiles are readable without a token too.
LISTENBRAINZ_TOKEN=
# Backward-compat: the old single value still works as a fallback when
# RECOMMEND_LISTENBRAINZ_USERS is empty. New setups use the list above.
LISTENBRAINZ_USER=

# ─── OPTIONAL: charts-flashback (top up the FLASHBACK FM rotation) ──────────
# Download-only (no playlists): reads the "recently played" rotation of the
# FLASHBACK FM decade channels (GraphQL, public) and lets the SHARED library
# grow. The decade display is handled by the Navidrome Smart Playlists (NSP),
# which filter by year - so the topped-up songs get a year tag (MusicBrainz,
# fallback = channel decade).
#
# On/off switch (true/false, default true).
# false = pause the service (container stays, no error, status "idle").
# When true, FLASHBACK_HASH is additionally required - otherwise the service
# also stays "idle" (no fetch, no error).
FLASHBACK_ENABLED=true
# Persisted-query hash of the LastPlayed query (public, NOT a secret). It can
# change if FLASHBACK FM rebuilds its app: then open the network tab in the
# browser on flashbackfm.ch, filter for "played", and copy the hash from the
# request URL (.../LastPlayed/<HASH>?). Empty = feature off.
# A dead hash becomes visible as an error in charts-watchdog/dashboard.
FLASHBACK_HASH=a910632a0819233aa0d0791b53c3638b69902077
# Streams (streamName), comma-separated. IMPORTANT: only the live main stream
# "flashbackfm.ffm" keeps a played history (across all decades mixed).
# The thematic decade/artist channels return played=null -> not useful here.
# The release year is in the title "(YYYY)".
FLASHBACK_CHANNELS=flashbackfm.ffm
# Run interval in hours (radio rotation -> 1-2h is plenty).
FLASHBACK_INTERVAL_HOURS=2
# Max. new songs per run (cap against overflow) and how many "recently
# played" entries are queried per channel.
FLASHBACK_LIMIT=50
FLASHBACK_PLAYED_LIMIT=50
# MusicBrainz year resolution (for the decade NSPs). 1 = on. The user agent
# must be meaningful (MusicBrainz requirement).
MB_ENABLED=1
MB_USER_AGENT=charts-flashback/1.0 (self-hosted)

# charts-recommend HTTP robustness (ListenBrainz/Last.fm):
# Timeout per request (seconds) and number of attempts per request. If the
# fetch fails after all attempts, the service reports status="error" (dashboard
# turns red) and sends a Pushover alert.
RECOMMEND_HTTP_TIMEOUT=30
RECOMMEND_HTTP_RETRIES=3
# Send the error alert only on a state change (1) instead of on every 24h run (0).
# Prevents daily spam during a longer outage; an all-clear is sent once as
# soon as the fetch works again.
RECOMMEND_NOTIFY_ONLY_ON_CHANGE=1

# ─── OPTIONAL: charts-digest (daily summary) ────────────────────────────────
# Sends a Pushover summary once a day of the songs newly sorted into the
# library the previous day, grouped by source (Charts/Mundart/FLASHBACK/
# manual ...). Data basis: the import log kept by charts-import.
# Time of the daily message (local time). Default 09:00 (review of previous day).
DIGEST_HOUR=9
DIGEST_MINUTE=0
# Review window in hours (default 24 = since the same time yesterday).
DIGEST_WINDOW_HOURS=24
# Max. songs per source in the message (safety net). The goal is to list as
# many songs as possible - the real cap is the Pushover character limit (1024),
# long titles are trimmed at the end for that. Rest as "... and N more".
DIGEST_MAX_PER_SOURCE=100
# Also send a message when there are 0 new songs (1) or stay silent (0, default).
DIGEST_NOTIFY_WHEN_EMPTY=0
# Import log retention in days (older entries are discarded on the run).
DIGEST_LOG_RETENTION_DAYS=7
# Send a summary immediately on container start (1) - for testing only.
DIGEST_RUN_ON_START=0
# Trigger manually at any time (sends immediately, even with 0 new songs):
#   docker exec charts-digest python -m app.main --now

# ─── USER / PERMISSIONS ─────────────────────────────────────
# Determine with "id <user>" on the host. Synology: e.g. 1027 / 100.
PUID=1027
PGID=100
TZ=Europe/Zurich

# ─── slskd ──────────────────────────────────────────────────
# Location of the slskd config + DB (slskd.yml). Default: ./slskd/slskd-config
SLSKD_CONFIG_DIR=./slskd/slskd-config

# ─── OPTIONAL: Last.fm (genre filter + recommendations) ─────
# API key from https://www.last.fm/api/account/create. Empty = genre filter off.
LASTFM_API_KEY=

# ─── OPTIONAL: Pushover (notifications) ─────────────────────
# Notifications are completely optional - without these two values all
# services keep running silently (log only). If you want them, you need TWO
# values from your Pushover account (pushover.net):
#   1) PUSHOVER_USER  = your personal USER KEY (shown at the top of the
#      dashboard after you log in).
#   2) PUSHOVER_TOKEN = the API TOKEN of your OWN application, which you create
#      once under "Create an Application/API Token".
# SENDER NAME: the name shown on your phone as the sender is the NAME of this
# application - changeable ONLY in the Pushover web UI (edit application),
# NOT via a variable here. If you rename the app, new messages arrive under
# the new name; already delivered ones keep the old one.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Several devices possible, comma-separated (e.g. iPhone-Max,Tablet-Anna) - one
# separate message is sent per device. All devices belong to the same Pushover
# account. Empty field = delivery to all devices of the account.
PUSHOVER_DEVICE=
# Protection against double push: invalid/disabled device names are filtered
# out of PUSHOVER_DEVICE before sending (otherwise Pushover delivers an unknown
# name to ALL devices as a fallback). For this the real device list of the
# account is cached; this TTL (seconds) controls how long.
# Optional, default 3600 (= 1h).
# PUSHOVER_DEVICES_TTL=3600

# ─── OPTIONAL: Pushover per-service enable switch ───────────
# Each service that sends Pushover messages has its own enable switch, so you
# can pick which services may notify you without removing the token/user. Each
# PUSHOVER_<SERVICE>_ENABLED defaults to 1 (on); set it to 0 to mute that one
# service's Pushover output while keeping it enabled for the others. The
# token/user values above stay in place either way.
# Service suffixes: SYNC, HITPARADE, DOWNLOAD, IMPORT, RECOMMEND, DIGEST,
# FLASHBACK, UPGRADE, WATCHDOG. Examples (commented out = default 1 = on):
# PUSHOVER_SYNC_ENABLED=1
# PUSHOVER_HITPARADE_ENABLED=1
# PUSHOVER_DOWNLOAD_ENABLED=1
# PUSHOVER_IMPORT_ENABLED=1
# PUSHOVER_RECOMMEND_ENABLED=1
# PUSHOVER_DIGEST_ENABLED=1
# PUSHOVER_FLASHBACK_ENABLED=1
# PUSHOVER_UPGRADE_ENABLED=1
# charts-watchdog is the alarm service - it reports when a container fails or
# recovers. Normally keep it enabled; only mute it if you really want no alerts.
# PUSHOVER_WATCHDOG_ENABLED=1

# ─── OPTIONAL: Pushover notification sound per service ──────
# Each service sends its own notification sound. Every variable below already
# carries the code default of the respective service; leaving it unset / here
# commented out = that code-default sound applies. Setting it explicitly =
# override. Setting an empty value (e.g. PUSHOVER_SOUND_SYNC=) = NO sound field
# -> Pushover uses the account default sound.
# Valid sounds (Pushover standard): pushover, magic, cosmic, intermission,
# bike, bugle, cashregister, classical, falling, gamelan, incoming, mechanical,
# pianobar, siren, spacealarm, tugboat, alien, climb, persistent, echo, updown,
# none (= silent), vibrate.
# PUSHOVER_SOUND_SYNC=falling
# PUSHOVER_SOUND_HITPARADE=falling
# PUSHOVER_SOUND_DOWNLOAD=falling
# PUSHOVER_SOUND_IMPORT=incoming
# Separate sound ONLY for songs requested manually via charts-songrequest
# ("Your song has arrived!"). Default magic -> the user hears that THEIR song
# is here. The normal charts-import batch message uses PUSHOVER_SOUND_IMPORT (incoming).
# PUSHOVER_SOUND_MANUAL=magic
# PUSHOVER_SOUND_RECOMMEND=falling
# PUSHOVER_SOUND_DIGEST=magic
# PUSHOVER_SOUND_FLASHBACK=falling
# PUSHOVER_SOUND_UPGRADE=cosmic
# charts-songrequest currently does NOT send a Pushover message itself (the
# availability message comes from charts-import) -> this sound is currently
# without effect, kept for consistency.
# PUSHOVER_SOUND_SONGREQUEST=magic
# PUSHOVER_SOUND_WATCHDOG=siren

# ─── OPTIONAL: charts-watchdog (health monitoring) ──────────
# Watches all containers of the stack and sends a Pushover message when one
# becomes unhealthy, gets stuck in a restart loop or stops (uses the
# PUSHOVER_* values above). Without a Pushover config it runs silently (log only).
# Which containers are watched (space-separated). Default = all.
WATCH_CONTAINERS=slskd charts-sync charts-hitparade charts-flashback charts-download charts-import charts-recommend charts-upgrade charts-songrequest charts-digest charts-watchdog charts-dashboard
# Poll interval in seconds.
WATCH_INTERVAL_SECONDS=30
# Debounce: only report a problem when it persists for this many polls in a row
# (prevents false alarms from brief start/restart hiccups). 2 = ~60s.
WATCH_DEBOUNCE_POLLS=2
# All-clear only after this many OK polls in a row. Prevents a flapping app
# from constantly sending problem/OK messages. 3 = ~90s stable.
WATCH_RECOVER_POLLS=3
# After a problem message, no further one for the same app for this many
# seconds (no matter how often it flaps). 1800 = 30 min.
WATCH_COOLDOWN_SECONDS=1800

# ─── OPTIONAL: Lidarr integration (charts-import) ───────────
LIDARR_URL=
LIDARR_API_KEY=

# ─── OPTIONAL: web UI port (charts-songrequest) ─────────────
SONGREQUEST_PORT=5056
# Random string for session cookies (openssl rand -hex 32). Empty = ok.
SESSION_SECRET=

# ─── charts-config: snippet/config web UI ───────────────────
# Quellen-Finder + Energy channel browser. Externally reachable, so it will
# NOT start without a password (fail-closed, like the dashboard/songrequest).
CONFIG_PORT=5058
# Own login: user "admin" + CONFIG_PASSWORD. If CONFIG_PASSWORD is empty it
# falls back to the shared APP_USERS / APP_PASSWORD. Set at least one.
CONFIG_USERNAME=admin
CONFIG_PASSWORD=
# Advisory enable flag (the UI has no run-loop; the real off-switch is simply
# not starting the charts-config container). Kept for parity with the stack.
CONFIG_ENABLED=true
# LASTFM_API_KEY / SESSION_SECRET / APP_USERS / APP_PASSWORD / CHARTS_LANG /
# DASHBOARD_GENRE_CACHE_TTL are shared with the rest of the stack (already
# defined above); charts-config reuses them.

# ─── charts-dashboard (status UI) ───────────────────────────
# Web interface that shows whether all services are running, connections are
# healthy and what was processed last. The UI itself is optional - but IF you
# use it, a login is REQUIRED: without DASHBOARD_PASSWORD (or APP_USERS/
# APP_PASSWORD) the charts-dashboard container will NOT start (constant restart),
# for the same security reason as charts-songrequest - otherwise the page is
# openly reachable. Set DASHBOARD_PASSWORD further below.
DASHBOARD_PORT=5057
# Auto-refresh of the page in seconds.
DASHBOARD_REFRESH_SECONDS=15
# How often the charts share / quarantine numbers are recalculated (seconds).
# Small folders, cheap -> default 5 min.
DASHBOARD_STATS_TTL=300
# How often the library (Music) is re-counted (seconds). The folder scan is
# expensive (~10s on HDD), but the collection barely grows -> default 24 h.
DASHBOARD_LIBRARY_TTL=86400
# Cache TTL for the live reachability checks of the external services
# (ListenBrainz/Deezer/Last.fm/iTunes/Pushover) in seconds. Default 2 min,
# deliberately decoupled from the 15s poll -> no WAN request / rate limit flood.
DASHBOARD_EXTERNAL_TTL=120

# Cache TTL of the Deezer genre table in the source finder (seconds). The finder
# at the bottom of the dashboard fetches the genre IDs fresh once a day (refresh
# on the first call after expiry, no cronjob). Default 24 h. Optional.
DASHBOARD_GENRE_CACHE_TTL=86400
# Own dashboard login (separate from charts-songrequest): user admin
# + this password. REQUIRED when you use the dashboard - if it stays empty (and
# no APP_USERS/APP_PASSWORD is set either), the container will not start. Set
# a password here:
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ─── charts-download: which missing files to top up ────────
# Separated with ;. Contains the ONE combined recommend miss-list, so the
# recommendations are topped up too. Missing files are harmless.
MISSING_FILES=/charts/missing.txt;/charts/missing-mundart.txt;/charts/missing-flashback.txt;/charts/missing-hitparade.txt;/charts/missing-recommend.txt

# ─── charts-hitparade (official Swiss charts) ───────────────
# Fetches the Swiss single Top 100 from hitparade.ch weekly (Sundays).
# On/off switch (true/false, default true).
# false = pause the service (container stays, no error, status "idle").
HITPARADE_ENABLED=true
# Which charts (comma-separated): "singles" (Top 100, works).
# Do NOT use "singles-ch" - the page loads that list via JavaScript, the HTML
# contains 0 songs (the CH hits are in the Top 100 anyway).
HITPARADE_CHARTS=singles
# Schedule: weekday (0=Mon ... 6=Sun) + time. Default Sunday 20:00.
HITPARADE_WEEKDAY=6
HITPARADE_HOUR=20
HITPARADE_MINUTE=0

# ─── Language ───────────────────────────────────────────────
# Language for output (logs, Pushover, UI). Empty = English (default).
# Available: de (German), fr (French). The language files live CENTRALLY
# in charts-stack/lang/<code>.json and are shared across ALL services (like
# this .env); mounted read-only to /lang. You add a new language by creating
# charts-stack/lang/<code>.json (copy the keys from en.json).
# NOTE: this variable now applies to ALL Python services (charts-watchdog
# and charts-dashboard follow separately).
CHARTS_LANG=

# ─── charts-sync: playlist order ────────────────────────────
#   chart        = by chart position (number 1 on top)
#   newest-first = new additions on top
PLAYLIST_ORDER=chart

# ─── charts-sync: chart sources (CHARTS, JSON) ──────────────
# ALTERNATIVE to the single-line CHARTS variable: load the playlist definition
# from a READABLE, multi-line file (recommended when you maintain several
# playlists/sources). Create charts-sync/charts.json (template:
# charts-sync/charts.json.example) and set:
#   CHARTS_FILE=/config/charts.json
# Priority: CHARTS_FILE (if set + file exists + valid JSON) >
# CHARTS (below) > built-in defaults. Empty = file path off, CHARTS is used.
# The file is mounted read-only to /config/charts.json via compose.yml.
CHARTS_FILE=

# JSON list of the playlists + sources. The bundled IDs are EXAMPLES -
# replace them with your own (the Deezer playlist ID is in the web link
# deezer.com/.../playlist/<ID>). Leave empty = built-in defaults in the code.
# Note: must be ONE line.
# Recommended per source: the "service" field ("deezer" or "lastfm") - then it
# is unambiguous which service is meant (without it, it is derived from
# "type"/"method", so it stays backward-compatible). Full field/ID reference +
# ready-made examples (Country, 80s/90s, ...): see CHARTS-SOURCES.md.
# You can find new source IDs conveniently in the dashboard "source finder" (below).
# WARNING: this example contains two "lastfm" sources - they need a
# LASTFM_API_KEY (see above). WITHOUT a key they are skipped cleanly on the run
# (the playlist is still built from the Deezer sources), but two error lines
# appear in the log each. If you have no Last.fm key: set the two lastfm
# entries to "enabled":false, then the log stays clean.
CHARTS=[{"sources":[{"service":"deezer","type":"chart","source":"0","limit":100,"enabled":true},{"service":"deezer","type":"playlist","source":"1313617925","limit":"all","enabled":true},{"service":"lastfm","method":"geo.getTopTracks","country":"Switzerland","limit":100,"enabled":true},{"service":"lastfm","method":"chart.getTopTracks","limit":100,"enabled":true}],"name":"charts.m3u","title":"Aktuelle Hits & Charts","missing":"missing.txt"},{"sources":[{"service":"deezer","type":"playlist","source":"658561775","limit":"all","enabled":true}],"name":"mundart.m3u","title":"Schweizer Mundart","missing":"missing-mundart.txt","exclude_artists":["Nemo","Trauffer"]}]

# ─── Fine-tuning (change only if needed) ────────────────────
# Quality / selection
MIN_BITRATE=256
# charts-download: 0 = really download, 1 = test only (DRY_RUN)
DRY_RUN=0
# charts-upgrade: starts in test mode (1) to be safe. Switch to 0 only once
# the upsampling detection in the log is convincing.
UPGRADE_DRY_RUN=1
# Genre filter (charts-sync): opt-in, off by default. 1 = filter country/Schlager
# out of the pop charts (needs LASTFM_API_KEY). A per-playlist "genre_filter"
# field in CHARTS/charts.json overrides this global default (see CHARTS-SOURCES.md).
GENRE_FILTER=0
# Cleanup: keep the N newest downloads in the slskd share.
KEEP_LATEST=500
# Quarantine (_rejected): automatically delete rejected files older than N days
# (otherwise the folder grows without bound). 0 = never delete.
REJECTED_RETENTION_DAYS=14
# Upgrade trash (.charts-trash): delete replaced versions after N days.
TRASH_RETENTION_DAYS=30

# ─── charts-import: metadata backfill (fill in missing cover/ReplayGain) ─
# If an external source was briefly unreachable during import (iTunes/Deezer for
# cover, ffmpeg for ReplayGain), the song is imported anyway - but then without
# cover/ReplayGain. This periodic run fills in such gaps. Scope: ONLY the chart
# songs from the manifest, the rest of the library stays untouched.
# Interval in hours (0 = backfill off). Default 24h = once daily.
BACKFILL_INTERVAL_HOURS=24
# Pause between the cover API calls (ms), eases iTunes/Deezer rate limits.
BACKFILL_SLEEP_MS=400
# Max. files per backfill run (0 = all). Cap against very long runs.
BACKFILL_LIMIT=0
# Reconcile UPPERCASE flashback names in the backfill against the official
# Deezer spelling and correct them on a SAFE match (rename + tags + manifest).
# Uncertain cases (ABBA, R.E.M., alias artists) stay untouched - never guessed.
# 1 = on, 0 = off.
BACKFILL_RECANON=1

# ─── charts-import: preserve "date added" (file mtime) ──────
# Navidrome derives a song's "date added" from the file mtime. When charts-import
# only RETOUCHES an existing file (retag, cover embed, ReplayGain) or UPGRADES a
# song in place, it keeps the original mtime so the song does NOT wrongly jump to
# the top of a "recently added" playlist. First-time imports keep their fresh
# download mtime (correct date added). 1 = on (default), 0 = let every write
# bump the mtime (old behavior).
PRESERVE_MTIME=1

# --- charts-energy (Swiss NRJ / energy.ch webradio source) ---
# OFF by default: a fresh clone must NOT start polling Icecast unexpectedly.
ENERGY_ENABLED=0
# Channel list (JSON, single line). Three per-channel modes:
#   own     -> writes its own energy-<slug>.m3u (+ missing-energy-<slug>.txt).
#              The playlist name MUST be energy-*.m3u (reserved namespace); any
#              other name is refused (use feed to write into an existing list).
#   feed    -> no playlist; hands tracks to an EXISTING charts-sync theme
#              (e.g. mundart) via .charts-energy-feed-<theme>.json.
#   library -> download-only (NO .m3u), like charts-flashback: tops up the
#              shared library and resolves a release year so the song shows up
#              in the right decade via the Navidrome Smart Playlists (NSP).
# Example: Mundart via feed, Pop as own, 80s/90s as library (decades = NSP).
# ENERGY_CHANNELS=[{"slug":"energymadeinswitzerland","mode":"feed","theme":"mundart","enabled":true},{"slug":"energypop","title":"Energy Pop 🎶","mode":"own","playlist":"energy-pop.m3u","enabled":true},{"slug":"energy80s","mode":"library","enabled":true},{"slug":"energy90s","mode":"library","enabled":true}]
ENERGY_CHANNELS=
ENERGY_POLL_SECONDS=90
ENERGY_MATCH_INTERVAL_MINUTES=30
ENERGY_TRACK_RETENTION_DAYS=30
ENERGY_MAX_TRACKS_PER_CHANNEL=500
# library mode: MusicBrainz year resolution (for the decade NSPs). 1 = on.
MB_ENABLED=1
MB_USER_AGENT_ENERGY=charts-energy/1.0 (self-hosted)
# library mode writes ONE shared missing file. Append it to MISSING_FILES so
# charts-download fetches it (shipped MISSING_FILES default stays unchanged):
#   MISSING_FILES=/charts/missing.txt;/charts/missing-energy-library.txt
ENERGY_LIBRARY_MISSING_FILE=missing-energy-library.txt
